# ============================================================================
# LARAVEL APPLICATION CONFIGURATION
# ============================================================================

# Nama aplikasi (akan muncul di title, email, dll)
APP_NAME=TowerTrack

# Environment aplikasi (local/staging/production)
APP_ENV=local

# Application Key - JANGAN diisi manual! Jalankan: php artisan key:generate
APP_KEY=

# Debug Mode (true untuk development, false untuk production)
APP_DEBUG=true

# URL aplikasi (local: http://127.0.0.1:8000, production: https://domain.com)
APP_URL=http://127.0.0.1:8000

# Asset URL (opsional, uncomment jika pakai ngrok atau CDN)
#ASSET_URL=http://localhost:8000

# Force HTTPS (false untuk local, true untuk production/ngrok)
FORCE_HTTPS=false

# Locale Configuration
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# OpenRouteService API - Daftar di https://openrouteservice.org/dev/#/signup
# Quota gratis: 2000 requests/hari, 40 requests/menit
OPENROUTESERVICE_API_KEY= #isi app keynya di sini
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Security
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Buat database MySQL baru, lalu isi informasi di bawah
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=towertrack
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SESSION_HTTP_ONLY=false
SESSION_PATH=/
SESSION_ENCRYPT=false

# Broadcast Configuration
BROADCAST_CONNECTION=log

# Filesystem Configuration
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION=database

# Cache Configuration
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached Configuration (jika menggunakan memcached)
MEMCACHED_HOST=127.0.0.1

# Redis Configuration (jika menggunakan redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration - Gmail SMTP
# Setup: https://myaccount.google.com/apppasswords
# Gunakan App Password, BUKAN password Gmail biasa!
# Pastikan 2-Step Verification sudah aktif
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=emailkamu@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=emailkamu@gmail.com
MAIL_FROM_NAME="TowerTrack"

# AWS Configuration (opsional, jika menggunakan S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare Turnstile CAPTCHA
# Test keys untuk development (selalu pass)
# Untuk production: https://dash.cloudflare.com -> Turnstile -> Add Site
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"